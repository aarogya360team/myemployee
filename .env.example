# Platform (one Vercel project, many shops)
# Hosted Supabase Postgres (or Neon). Do not use SQLite. Docker Postgres is optional, not required.

# Supabase: Project Settings → Database
# DATABASE_URL = Transaction / pooled (port 6543, ?pgbouncer=true)
# DIRECT_URL   = Session / direct (port 5432) for prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

SESSION_SECRET="change-me-to-a-long-random-string"
PLATFORM_NAME="Aurel"
DEMO_MODE="false"

# Google sign-in (optional). Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/google/callback
#   https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL="http://localhost:3000"

# Shared model key — never a tenant identifier.
# Shop WhatsApp / Razorpay / delivery secrets belong in Integration rows.
LLM_API_KEY=""

# Optional Supabase Storage (service role stays server-side only)
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# WhatsApp Embedded Signup (optional). Merchant never sees these labels in the UI.
NEXT_PUBLIC_META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID=""
META_WEBHOOK_VERIFY_TOKEN="aurel-whatsapp-verify"
