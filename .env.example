# Platform (one Vercel project, many shops)
# Hosted Supabase Postgres (or Neon). Do not use SQLite.

# Vercel is IPv4-only. Do NOT use db.XXXX.supabase.co for DIRECT_URL — that host
# is often IPv6-only and Prisma fails with P1001.
#
# Copy BOTH strings from Supabase → Connect → ORMs → Prisma. Do not guess the
# host. aws-0-ap-south-1 is only an example — the wrong region or aws-0 vs aws-1
# prefix returns: tenant/user postgres.PROJECT_REF not found.
#
# DATABASE_URL = Transaction pooler (port 6543, pgbouncer=true)
# DIRECT_URL   = Session pooler (port 5432 on *.pooler.supabase.com)
# Username on the pooler is postgres.PROJECT_REF not postgres.
# Encode @ in the password as %40.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

SESSION_SECRET="change-me-to-a-long-random-string"
PLATFORM_NAME="Aurel"
DEMO_MODE="false"

# Google sign-in (optional). Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/google/callback
#   https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL="http://localhost:3000"

# Shared model key — never a tenant identifier.
# Paste your OpenAI secret key (sk-...). LLM_API_KEY and OPENAI_API_KEY both work.
# Optional: LLM_MODEL=gpt-4o-mini  LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=""
OPENAI_API_KEY=""

# Optional Supabase Storage (service role stays server-side only)
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# WhatsApp Embedded Signup. Merchant never sees WABA/tokens in the UI.
# Create at https://developers.facebook.com → your app → WhatsApp → Configuration
NEXT_PUBLIC_META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID=""
META_WEBHOOK_VERIFY_TOKEN="aurel-whatsapp-verify"
META_API_VERSION="v21.0"
